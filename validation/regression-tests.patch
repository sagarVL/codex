+            // Only HTTP's TransportError::Connection maps to ConnectionFailed.
+            assert!(matches!(
+                error.details(),
+                codex_protocol::error::CodexErrorDetails::Stream(_)
+            ));
+            assert!(error.retry_delay(1).is_some());
+        }
+    }
