+#[tokio::test]
+async fn direct_route_rejects_untrusted_websocket_certificate() {
+    let (_, acceptor, _) = test_tls_configs();
+    let config = ClientConfig::builder()
+        .with_root_certificates(RootCertStore::empty())
+        .with_no_client_auth();
+    assert_direct_route_rejects_certificate(Arc::new(config), acceptor, "localhost").await;
+}
+
+#[tokio::test]
+async fn direct_route_rejects_websocket_certificate_for_wrong_hostname() {
+    let (config, acceptor, _) = test_tls_configs();
+    // The trusted certificate contains only the DNS name localhost, not this IP address.
+    assert_direct_route_rejects_certificate(config, acceptor, "127.0.0.1").await;
+}
+
+async fn assert_direct_route_rejects_certificate(
+    config: Arc<ClientConfig>,
+    acceptor: TlsAcceptor,
+    host: &str,
+) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let target_task = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        assert!(acceptor.accept(stream).await.is_err());
+    });
+    let request = format!("wss://{host}:{port}/v1/responses")
+        .into_client_request()
+        .unwrap();
+    let result = connect(
+        request,
+        WebSocketConfig::default(),
+        Some(config),
+        OutboundProxyRoute::Direct,
+        TcpNodelay::Enabled,
+        /*loopback_direct*/ false,
+    )
+    .await;
+    let Err(tokio_tungstenite::tungstenite::Error::Io(error)) = result else {
+        panic!("expected TLS certificate validation to fail");
+    };
+    assert!(matches!(
+        error
+            .get_ref()
+            .and_then(|source| source.downcast_ref::<rustls::Error>()),
+        Some(rustls::Error::InvalidCertificate(_))
+    ));
+    target_task.await.unwrap();
+}
